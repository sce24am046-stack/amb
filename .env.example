# Frontend Environment Configuration Example
# Copy this file to .env or .env.local to configure your environment.

# Backend API Base URL
# For local development with Vite proxy: leave blank or set to http://localhost:5000
# For production on Vercel: set to your deployed Render backend URL e.g. https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Firebase Web Client Configuration (Optional - College Demo Mode operates seamlessly without these)
# Retrieve from Firebase Console > Project Settings > General > Your Apps > Web App
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyExampleOnlyNotReal123456
VITE_FIREBASE_AUTH_DOMAIN=smart-ambulance-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-ambulance-demo
VITE_FIREBASE_STORAGE_BUCKET=smart-ambulance-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
